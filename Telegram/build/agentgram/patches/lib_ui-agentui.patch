@@ -0,0 +1,39 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// Agentgram: hooks that let the application paint frosted glass
+// below popup menus and below the dimmed layer of boxes.
+//
+#pragma once
+
+#include "base/basic_types.h"
+
+class QPainter;
+class QWidget;
+class QPixmap;
+class QRect;
+
+namespace Ui::AgentGlass {
+
+struct Hooks {
+	// Paints the frosted backdrop of a popup menu into `inner`,
+	// in the menu coordinates, before the menu items are painted.
+	// Returns true if the glass replaces the plain menu background.
+	Fn<bool(QPainter&, QWidget *menu, const QRect &inner)> menuBackdrop;
+
+	// Paints the frosted copy of the content below the box layer.
+	// `bodyCache` may be null after the show animation is finished.
+	Fn<void(
+		QPainter&,
+		QWidget *background,
+		const QPixmap &bodyCache,
+		float64 opacity)> layerBackdrop;
+};
+
+void SetHooks(Hooks hooks);
+[[nodiscard]] const Hooks &CurrentHooks();
+
+} // namespace Ui::AgentGlass
